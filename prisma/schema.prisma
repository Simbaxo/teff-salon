// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id                Int     @id @default(autoincrement())
  nameEs            String
  nameEn            String
  category          String
  price             Int
  estimatedDuration Int
  requiresApproval  Boolean @default(false)
  active            Boolean @default(true)

  employeeServices    EmployeeService[]
  serviceAddons       ServiceAddon[]
  appointmentServices AppointmentService[]
}

model Employee {
  id     Int     @id @default(autoincrement())
  name   String
  active Boolean @default(true)

  employeeServices EmployeeService[]
  appointments     Appointment[]
  // Tracks commissions earned by this employee
  commissions      Commission[]
  tips             Tip[]

  // Optional login account for employees who need system access
  user User?
}

// Login accounts for people who can access the internal TEFF system
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean  @default(true)

  // Not every login account has to be a salon technician
  employeeId Int?      @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  OWNER
  RECEPTIONIST
  TECHNICIAN
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model EmployeeService {
  employeeId Int
  serviceId  Int

  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@id([employeeId, serviceId])
}

model Addon {
  id                Int     @id @default(autoincrement())
  nameEs            String
  nameEn            String
  price             Int
  estimatedDuration Int
  active            Boolean @default(true)

  serviceAddons     ServiceAddon[]
  appointmentAddons AppointmentAddon[]
}

model ServiceAddon {
  serviceId Int
  addonId   Int

  service Service @relation(fields: [serviceId], references: [id])
  addon   Addon   @relation(fields: [addonId], references: [id])

  @@id([serviceId, addonId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  // Normalized phone number uniquely identifies a customer
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())

  appointments Appointment[]
  bookings     Booking[]
}

// Represents one customer-facing salon visit.
// A booking may contain multiple technician appointments.
model Booking {
  id         Int @id @default(autoincrement())
  customerId Int

  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id         Int  @id @default(autoincrement())
  customerId Int
  employeeId Int
  bookingId  Int?

  date      DateTime
  startTime String
  duration  Int
  status    String
  notes     String?

  createdAt DateTime @default(now())

  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  appointmentServices AppointmentService[]
  appointmentAddons   AppointmentAddon[]
  // Allows an appointment to be connected to a sale
  saleAppointments    SaleAppointment[]
}

model AppointmentService {
  appointmentId  Int
  serviceId      Int
  bookedPrice    Int
  bookedDuration Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model AppointmentAddon {
  appointmentId  Int
  addonId        Int
  bookedPrice    Int
  bookedDuration Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  addon       Addon       @relation(fields: [addonId], references: [id])

  @@id([appointmentId, addonId])
}

// Represents on completed customer transcation
model Sale {
  id            Int      @id @default(autoincrement())
  subtotal      Int
  discountTotal Int      @default(0)
  finalTotal    Int
  createdAt     DateTime @default(now())

  saleAppointments SaleAppointment[]
  // A sale can contain multiple payment methods
  payments         Payment[]
  // A sale can generate commissions for one or more technicians
  commissions      Commission[]
  lineItems        SaleLineItem[]
  tips             Tip[]
}

// Connects one sale to one or more appointments
model SaleAppointment {
  saleId        Int
  appointmentId Int

  sale        Sale        @relation(fields: [saleId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@id([saleId, appointmentId])
  @@unique([appointmentId])
}

// Stores the final services and add-ons that were actually sold
model SaleLineItem {
  id     Int @id @default(autoincrement())
  saleId Int

  itemType  String
  itemId    Int?
  itemName  String
  unitPrice Int

  sale Sale @relation(fields: [saleId], references: [id])
}

// Stores each payment used to pay a sale
model Payment {
  id            Int      @id @default(autoincrement())
  saleId        Int
  paymentMethod String
  amount        Int
  processingFee Int      @default(0)
  createdAt     DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
}

// Stores the commission earned by a technician from a sale
model Commission {
  id               Int       @id @default(autoincrement())
  saleId           Int
  employeeId       Int
  commissionBase   Int
  commissionRate   Int
  commissionAmount Int
  status           String    @default("PENDING")
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

// Tracks tips belonging directly to technicians
model Tip {
  id            Int       @id @default(autoincrement())
  saleId        Int
  employeeId    Int
  amount        Int
  paymentMethod String
  status        String    @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

// Stores configurable business targets and operational settings.
// A single settings row is used for TEFF today and can later expand per location.
model SalonSettings {
  id               Int      @id @default(autoincrement())
  weeklySalesGoal  Int      @default(0)
  monthlySalesGoal Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
