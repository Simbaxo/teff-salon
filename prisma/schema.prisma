// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id                Int     @id @default(autoincrement())
  nameEs            String
  nameEn            String
  category          String
  price             Int
  estimatedDuration Int
  requiresApproval  Boolean @default(false)
  active            Boolean @default(true)

  employeeServices    EmployeeService[]
  serviceAddons       ServiceAddon[]
  appointmentServices AppointmentService[]
}

model Employee {
  id     Int     @id @default(autoincrement())
  name   String
  active Boolean @default(true)

  employeeServices EmployeeService[]
  appointments     Appointment[]
  scheduleBlocks   EmployeeScheduleBlock[]

  // Tracks commissions earned by this employee
  commissions Commission[]
  tips        Tip[]

  // Payroll statements belonging to this technician.
  payrollEntries PayrollEntry[]

  // Optional login account for employees who need system access
  user User?
}

model EmployeeScheduleBlock {
  id         Int @id @default(autoincrement())
  employeeId Int

  // Calendar day and unavailable time range.
  date      DateTime
  startTime String
  endTime   String

  // Optional operational note such as:
  // "Vacaciones", "Llega tarde", "Cita médica".
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, date])
}

// Login accounts for people who can access the internal TEFF system
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean  @default(true)

  // Not every login account has to be a salon technician
  employeeId Int?      @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  pushSubscriptions  PushSubscription[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id Int @id @default(autoincrement())

  userId Int

  // Browser-generated Web Push subscription information.
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum InventoryMovementType {
  RESTOCK
  USAGE
  DAMAGED
  CORRECTION
}

enum UserRole {
  OWNER
  RECEPTIONIST
  TECHNICIAN
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model EmployeeService {
  employeeId Int
  serviceId  Int

  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@id([employeeId, serviceId])
}

model Addon {
  id                Int     @id @default(autoincrement())
  nameEs            String
  nameEn            String
  price             Int
  estimatedDuration Int
  active            Boolean @default(true)

  serviceAddons     ServiceAddon[]
  appointmentAddons AppointmentAddon[]
}

model ServiceAddon {
  serviceId Int
  addonId   Int

  service Service @relation(fields: [serviceId], references: [id])
  addon   Addon   @relation(fields: [addonId], references: [id])

  @@id([serviceId, addonId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  // Normalized phone number uniquely identifies a customer
  phone     String?  @unique
  email     String?
  createdAt DateTime @default(now())

  appointments Appointment[]
  bookings     Booking[]
}

// Represents one customer-facing salon visit.
// A booking may contain multiple technician appointments.
model Booking {
  id         Int @id @default(autoincrement())
  customerId Int

  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id         Int  @id @default(autoincrement())
  customerId Int
  employeeId Int
  bookingId  Int?

  date      DateTime
  startTime String
  duration  Int
  status    String
  notes     String?

  createdAt DateTime @default(now())

  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  appointmentServices AppointmentService[]
  appointmentAddons   AppointmentAddon[]
  // Allows an appointment to be connected to a sale
  saleAppointments    SaleAppointment[]
}

model AppointmentService {
  appointmentId  Int
  serviceId      Int
  bookedPrice    Int
  bookedDuration Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model AppointmentAddon {
  id             Int @id @default(autoincrement())
  appointmentId  Int
  addonId        Int
  bookedPrice    Int
  bookedDuration Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  addon       Addon       @relation(fields: [addonId], references: [id])

  @@index([appointmentId])
  @@index([addonId])
}

// Represents on completed customer transcation
model Sale {
  id            Int      @id @default(autoincrement())
  subtotal      Int
  discountTotal Int      @default(0)
  finalTotal    Int
  createdAt     DateTime @default(now())

  saleAppointments SaleAppointment[]
  // A sale can contain multiple payment methods
  payments         Payment[]
  // A sale can generate commissions for one or more technicians
  commissions      Commission[]
  lineItems        SaleLineItem[]
  tips             Tip[]
}

// Connects one sale to one or more appointments
model SaleAppointment {
  saleId        Int
  appointmentId Int

  sale        Sale        @relation(fields: [saleId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@id([saleId, appointmentId])
  @@unique([appointmentId])
}

// Stores the final services and add-ons that were actually sold
model SaleLineItem {
  id     Int @id @default(autoincrement())
  saleId Int

  itemType  String
  itemId    Int?
  itemName  String
  unitPrice Int

  sale Sale @relation(fields: [saleId], references: [id])
}

// Stores each payment used to pay a sale
model Payment {
  id            Int      @id @default(autoincrement())
  saleId        Int
  paymentMethod String
  amount        Int
  processingFee Int      @default(0)
  createdAt     DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
}

// Stores the commission earned by a technician from a sale
model Commission {
  id               Int       @id @default(autoincrement())
  saleId           Int
  employeeId       Int
  commissionBase   Int
  commissionRate   Int
  commissionAmount Int
  status           String    @default("PENDING")
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  // Null until this commission is assigned to payroll.
  payrollEntryId Int?
  payrollEntry   PayrollEntry? @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
}

// Tracks tips belonging directly to technicians
model Tip {
  id            Int       @id @default(autoincrement())
  saleId        Int
  employeeId    Int
  amount        Int
  paymentMethod String
  status        String    @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  // Cash tips are already paid but still appear in earnings.
  payrollEntryId Int?
  payrollEntry   PayrollEntry? @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
}

model InventoryItem {
  id Int @id @default(autoincrement())

  name     String
  category String?
  unit     String  @default("unidad")

  // Current physical quantity available in the salon.
  quantity Int @default(0)

  // Item appears as low stock when quantity is at or below this value.
  lowStockThreshold Int @default(0)

  active Boolean @default(true)

  notes    String?
  // Public Vercel Blob URL for the inventory product photo.
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  @@index([active])
  @@index([category])
}

model InventoryMovement {
  id Int @id @default(autoincrement())

  inventoryItemId Int
  userId          Int

  type InventoryMovementType

  // Signed quantity change:
  // +10 = stock added
  // -2  = stock removed
  quantityChange Int

  // Snapshot quantities make the audit trail easier to verify.
  quantityBefore Int
  quantityAfter  Int

  note String?

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([userId, createdAt])
}

// Stores configurable business targets and operational settings.
// A single settings row is used for TEFF today and can later expand per location.
model SalonSettings {
  id               Int      @id @default(autoincrement())
  weeklySalesGoal  Int      @default(0)
  monthlySalesGoal Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// One Monday-Sunday payroll period for TEFF.
model PayrollPeriod {
  id Int @id @default(autoincrement())

  // Calendar dates stored at midnight UTC.
  startDate DateTime @unique
  endDate   DateTime
  payday    DateTime

  status PayrollStatus @default(DRAFT)

  reviewedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries PayrollEntry[]
}

// One technician's payroll statement for one period.
model PayrollEntry {
  id Int @id @default(autoincrement())

  payrollPeriodId Int
  employeeId      Int

  // Finalized financial snapshot in Colombian pesos.
  productionTotal Int @default(0)
  commissionTotal Int @default(0)
  tipsTotal       Int @default(0)
  bonusesTotal    Int @default(0)
  totalEarned     Int @default(0)

  loansTotal      Int @default(0)
  uniformsTotal   Int @default(0)
  otherDeductions Int @default(0)
  tipsAlreadyPaid Int @default(0)
  netPay          Int @default(0)

  status PayrollStatus @default(DRAFT)

  reviewedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  period   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  adjustments PayrollAdjustment[]
  commissions Commission[]
  tips        Tip[]

  // Prevent duplicate payroll entries for one technician/week.
  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId, status])
}

// Bonuses, loans, uniforms and other payroll adjustments.
model PayrollAdjustment {
  id Int @id @default(autoincrement())

  payrollEntryId Int
  type           PayrollAdjustmentType

  amount      Int
  description String?

  createdAt DateTime @default(now())

  entry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  PAID
}

enum PayrollAdjustmentType {
  BONUS
  LOAN
  UNIFORM
  OTHER_DEDUCTION
}
