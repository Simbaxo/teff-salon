// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id                Int     @id @default(autoincrement())
  nameEs            String
  nameEn            String
  category          String
  price             Int
  estimatedDuration Int
  requiresApproval  Boolean @default(false)
  active            Boolean @default(true)

  employeeServices    EmployeeService[]
  serviceAddons       ServiceAddon[]
  appointmentServices AppointmentService[]
}

model Employee {
  id     Int     @id @default(autoincrement())
  name   String
  active Boolean @default(true)

  // Whether this employee can be selected for salon services.
  isBookable Boolean @default(true)

  // How this employee is compensated.
  compensationType EmployeeCompensationType @default(COMMISSION)

  // Weekly salary in COP, used for fixed-salary employees.
  weeklySalary Int @default(0)

  // First payroll week eligible for fixed salary.
  // Null for commission-based employees.
  salaryStartDate DateTime?

  employeeServices EmployeeService[]
  appointments     Appointment[]
  scheduleBlocks   EmployeeScheduleBlock[]
  saleLineItems    SaleLineItem[]

  // Tracks commissions earned by this employee
  commissions Commission[]
  tips        Tip[]

  // Payroll statements belonging to this technician.
  payrollEntries PayrollEntry[]

  // Optional login account for employees who need system access
  user User?

  cashLoans CashMovement[] @relation("CashLoansToEmployee")
}

model EmployeeScheduleBlock {
  id         Int @id @default(autoincrement())
  employeeId Int

  // Calendar day and unavailable time range.
  date      DateTime
  startTime String
  endTime   String

  // Optional operational note such as:
  // "Vacaciones", "Llega tarde", "Cita médica".
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, date])
}

// Login accounts for people who can access the internal TEFF system
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  active       Boolean  @default(true)

  // Manual payroll payments recorded by this user.
  recordedPayrollPayments PayrollManualPayment[]

  // Not every login account has to be a salon technician
  employeeId Int?      @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  pushSubscriptions  PushSubscription[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingReadReceipts BookingReadReceipt[]
  // Weekly sales reviews completed by this user.
  weeklySalesReviews  WeeklySalesReview[]

  cashboxesOpened       Cashbox[]      @relation("CashboxOpenedBy")
  cashMovementsRecorded CashMovement[] @relation("CashMovementsRecorded")
  cashCountsRecorded    CashCount[]    @relation("CashCountsRecorded")

  expensesCreated  Expense[] @relation("ExpensesCreated")
  expensesReviewed Expense[] @relation("ExpensesReviewed")

  expenseReceiptsUploaded ExpenseReceipt[] @relation("ExpenseReceiptsUploaded")
}

model PushSubscription {
  id Int @id @default(autoincrement())

  userId Int

  // Browser-generated Web Push subscription information.
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum InventoryMovementType {
  RESTOCK
  USAGE
  DAMAGED
  CORRECTION
}

enum UserRole {
  OWNER
  RECEPTIONIST
  TECHNICIAN
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model EmployeeService {
  employeeId Int
  serviceId  Int

  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@id([employeeId, serviceId])
}

model Addon {
  id                Int     @id @default(autoincrement())
  nameEs            String
  nameEn            String
  price             Int
  estimatedDuration Int
  active            Boolean @default(true)

  serviceAddons     ServiceAddon[]
  appointmentAddons AppointmentAddon[]
}

model ServiceAddon {
  serviceId Int
  addonId   Int

  service Service @relation(fields: [serviceId], references: [id])
  addon   Addon   @relation(fields: [addonId], references: [id])

  @@id([serviceId, addonId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  // Normalized phone number uniquely identifies a customer
  phone     String?  @unique
  email     String?
  createdAt DateTime @default(now())

  appointments Appointment[]
  bookings     Booking[]
}

// Represents one customer-facing salon visit.
// A booking may contain multiple technician appointments.
model Booking {
  id         Int @id @default(autoincrement())
  customerId Int

  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  // Null for bookings created before source tracking.
  source BookingSource?

  customer     Customer      @relation(fields: [customerId], references: [id])
  appointments Appointment[]

  readReceipts BookingReadReceipt[]
}

model BookingReadReceipt {
  bookingId Int
  userId    Int

  readAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookingId, userId])
  @@index([userId, readAt])
}

model Appointment {
  id         Int  @id @default(autoincrement())
  customerId Int
  employeeId Int
  bookingId  Int?

  date      DateTime
  startTime String
  duration  Int
  status    String
  notes     String?

  createdAt DateTime @default(now())

  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])

  appointmentServices AppointmentService[]
  appointmentAddons   AppointmentAddon[]
  // Allows an appointment to be connected to a sale
  saleAppointments    SaleAppointment[]
  saleLineItems       SaleLineItem[]
}

model AppointmentService {
  appointmentId  Int
  serviceId      Int
  bookedPrice    Int
  bookedDuration Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
}

model AppointmentAddon {
  id             Int @id @default(autoincrement())
  appointmentId  Int
  addonId        Int
  bookedPrice    Int
  bookedDuration Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  addon       Addon       @relation(fields: [addonId], references: [id])

  @@index([appointmentId])
  @@index([addonId])
}

// Represents on completed customer transcation
model Sale {
  id            Int      @id @default(autoincrement())
  subtotal      Int
  discountTotal Int      @default(0)
  finalTotal    Int
  createdAt     DateTime @default(now())

  saleAppointments SaleAppointment[]
  // A sale can contain multiple payment methods
  payments         Payment[]
  // A sale can generate commissions for one or more technicians
  commissions      Commission[]
  lineItems        SaleLineItem[]
  tips             Tip[]
}

// Connects one sale to one or more appointments
model SaleAppointment {
  saleId        Int
  appointmentId Int

  sale        Sale        @relation(fields: [saleId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@id([saleId, appointmentId])
  @@unique([appointmentId])
}

// Stores the final services and add-ons that were actually sold
model SaleLineItem {
  id     Int @id @default(autoincrement())
  saleId Int

  itemType  String
  itemId    Int?
  itemName  String
  unitPrice Int

  // Financial attribution recorded at checkout.
  // Null for legacy sales that did not store these details.
  employeeId    Int?
  appointmentId Int?

  // Connect an add-on to the service that earned its revenue.
  parentLineItemId Int?

  sale        Sale         @relation(fields: [saleId], references: [id])
  employee    Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  parentLineItem SaleLineItem?  @relation("SaleLineItemAddons", fields: [parentLineItemId], references: [id], onDelete: Restrict)
  addonLineItems SaleLineItem[] @relation("SaleLineItemAddons")

  @@index([saleId])
  @@index([employeeId])
  @@index([appointmentId])
  @@index([parentLineItemId])
}

// Stores each payment used to pay a sale
model Payment {
  id            Int      @id @default(autoincrement())
  saleId        Int
  paymentMethod String
  amount        Int
  processingFee Int      @default(0)
  createdAt     DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])
}

// Stores the commission earned by a technician from a sale
model Commission {
  id               Int       @id @default(autoincrement())
  saleId           Int
  employeeId       Int
  commissionBase   Int
  commissionRate   Int
  commissionAmount Int
  status           String    @default("PENDING")
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  // Null until this commission is assigned to payroll.
  payrollEntryId Int?
  payrollEntry   PayrollEntry? @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
}

// Tracks tips belonging directly to technicians
model Tip {
  id            Int       @id @default(autoincrement())
  saleId        Int
  employeeId    Int
  amount        Int
  paymentMethod String
  status        String    @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  sale     Sale     @relation(fields: [saleId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  // Cash tips are already paid but still appear in earnings.
  payrollEntryId Int?
  payrollEntry   PayrollEntry? @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
}

model InventoryItem {
  id Int @id @default(autoincrement())

  name     String
  category String?
  unit     String  @default("unidad")

  // Current physical quantity available in the salon.
  quantity Int @default(0)

  // Item appears as low stock when quantity is at or below this value.
  lowStockThreshold Int @default(0)

  active Boolean @default(true)

  notes    String?
  // Public Vercel Blob URL for the inventory product photo.
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  @@index([active])
  @@index([category])
}

model InventoryMovement {
  id Int @id @default(autoincrement())

  inventoryItemId Int
  userId          Int

  type InventoryMovementType

  // Signed quantity change:
  // +10 = stock added
  // -2  = stock removed
  quantityChange Int

  // Snapshot quantities make the audit trail easier to verify.
  quantityBefore Int
  quantityAfter  Int

  note String?

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([userId, createdAt])
}

// Stores configurable business targets and operational settings.
// A single settings row is used for TEFF today and can later expand per location.
model SalonSettings {
  id               Int      @id @default(autoincrement())
  weeklySalesGoal  Int      @default(0)
  monthlySalesGoal Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// One Monday-Sunday payroll period for TEFF.
model PayrollPeriod {
  id Int @id @default(autoincrement())

  // Calendar dates stored at midnight UTC.
  startDate DateTime @unique
  endDate   DateTime
  payday    DateTime

  status PayrollStatus @default(DRAFT)

  reviewedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries PayrollEntry[]

  // Tracks verification of payments made before Nómina v1.
  reconciliationStatus PayrollReconciliationStatus @default(NOT_RECONCILED)

  reconciledAt DateTime?
}

// One technician's payroll statement for one period.
model PayrollEntry {
  id Int @id @default(autoincrement())

  payrollPeriodId Int
  employeeId      Int

  // Finalized financial snapshot in Colombian pesos.
  // Fixed salary earned during this payroll week.
  // Stored permanently in the weekly financial snapshot.
  salaryTotal     Int @default(0)
  productionTotal Int @default(0)
  commissionTotal Int @default(0)
  tipsTotal       Int @default(0)
  bonusesTotal    Int @default(0)
  totalEarned     Int @default(0)

  loansTotal      Int @default(0)
  uniformsTotal   Int @default(0)
  otherDeductions Int @default(0)
  tipsAlreadyPaid Int @default(0)
  netPay          Int @default(0)

  status PayrollStatus @default(DRAFT)

  reviewedAt DateTime?
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  period   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  adjustments PayrollAdjustment[]
  commissions Commission[]
  tips        Tip[]

  // Payments previously made outside the payroll system.
  historicalPayments PayrollHistoricalPayment[]

  // Payments manually completed after payroll approval.
  manualPayments PayrollManualPayment[]

  // Prevent duplicate payroll entries for one technician/week.
  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId, status])
}

// Bonuses, loans, uniforms and other payroll adjustments.
model PayrollAdjustment {
  id Int @id @default(autoincrement())

  payrollEntryId Int
  type           PayrollAdjustmentType

  amount      Int
  description String?

  createdAt DateTime @default(now())

  entry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)

  cashMovement CashMovement?

  @@index([payrollEntryId])
}

// Records money already paid to a technician outside Nómina.
// These entries do not initiate a new payment.

model PayrollHistoricalPayment {
  id Int @id @default(autoincrement())

  payrollEntryId Int

  // Amount previously delivered, in whole Colombian pesos.
  amount Int

  // Date the payment was actually made.
  paymentDate DateTime

  // CASH, TRANSFER, BOLD, or OTHER.
  paymentMethod String

  description String?

  // Prevent duplicate records when a request is retried.
  idempotencyKey String @unique

  // Optional bank transfer or payment receipt reference.
  paymentReference String?

  createdAt DateTime @default(now())

  entry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
  @@index([paymentDate])
}

// Records payments the Owner has already made outside TEFF.
// This model never initiates bank transfers.
model PayrollManualPayment {
  id Int @id @default(autoincrement())

  payrollEntryId Int

  // Amount delivered in whole Colombian pesos.
  amount Int

  // Actual date of payment.
  paymentDate DateTime

  // CASH, TRANSFER, or OTHER.
  paymentMethod String

  // Unique request identifier to prevent duplicate inserts.
  idempotencyKey String @unique

  // Optional bank or receipt reference.
  paymentReference String?

  description String?

  // The authenticated Owner who recorded the payment.
  recordedByUserId Int

  // Preserve who recorded each payment.
  recordedBy User @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  entry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Restrict)

  @@index([payrollEntryId])
  @@index([paymentDate])
  @@index([recordedByUserId])
}

/// Receptionist verification of weekly salon sales.
/// Independent from payroll approval and payment.
model WeeklySalesReview {
  id Int @id @default(autoincrement())

  // Monday of the reviewed week, stored at UTC midnight.
  weekStart DateTime @unique

  // User who confirmed the sales review.
  reviewedById Int
  reviewedBy   User @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  reviewedAt DateTime @default(now())

  // Financial snapshot at the time of review.
  salesCount Int
  salesTotal Int

  // Server-generated fingerprint of the reviewed sales data.
  snapshotHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewedById])
}

enum PayrollReconciliationStatus {
  NOT_RECONCILED
  PARTIALLY_RECONCILED
  SETTLED
}

enum PayrollStatus {
  DRAFT
  REVIEWED
  PAID
}

enum PayrollAdjustmentType {
  BONUS
  LOAN
  UNIFORM
  OTHER_DEDUCTION
}

enum EmployeeCompensationType {
  COMMISSION
  FIXED_WEEKLY
}

enum BookingSource {
  WEB
  INTERNAL
}

enum CashMovementType {
  OWNER_WITHDRAWAL
  BANK_DEPOSIT
  CASH_EXPENSE
  TECHNICIAN_LOAN
  CASH_ADJUSTMENT_IN
  CASH_ADJUSTMENT_OUT
  REVERSAL
}

// One continuous physical cashbox for TEFF.
model Cashbox {
  id Int @id

  openingBalance Int
  openedAt       DateTime @default(now())

  openedById Int
  openedBy   User @relation("CashboxOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)

  movements CashMovement[]
  counts    CashCount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Permanent history of manual cash movements.
model CashMovement {
  id Int @id @default(autoincrement())

  cashboxId Int
  type      CashMovementType

  // Positive for cash entering, negative for cash leaving.
  amount Int

  description String?

  recordedById Int
  employeeId   Int?

  // One cashbox loan corresponds to one payroll adjustment.
  payrollAdjustmentId Int? @unique

  // Prevent duplicate entries from repeated requests.
  idempotencyKey String @unique

  // Corrections reference the original movement.
  reversalOfId Int? @unique

  createdAt DateTime @default(now())

  cashbox Cashbox @relation(fields: [cashboxId], references: [id], onDelete: Restrict)

  recordedBy User @relation("CashMovementsRecorded", fields: [recordedById], references: [id], onDelete: Restrict)

  employee Employee? @relation("CashLoansToEmployee", fields: [employeeId], references: [id], onDelete: Restrict)

  payrollAdjustment PayrollAdjustment? @relation(fields: [payrollAdjustmentId], references: [id], onDelete: Restrict)

  reversalOf CashMovement? @relation("CashMovementReversals", fields: [reversalOfId], references: [id], onDelete: Restrict)

  reversedBy CashMovement? @relation("CashMovementReversals")

  @@index([cashboxId, createdAt])
  @@index([employeeId])
}

// Physical cash verification by reception.
model CashCount {
  id Int @id @default(autoincrement())

  cashboxId   Int
  countedById Int

  countedAmount  Int
  expectedAmount Int
  difference     Int

  // Prevent duplicate physical counts from repeated requests.
  idempotencyKey String @unique

  notes     String?
  createdAt DateTime @default(now())

  cashbox Cashbox @relation(fields: [cashboxId], references: [id], onDelete: Restrict)

  countedBy User @relation("CashCountsRecorded", fields: [countedById], references: [id], onDelete: Restrict)

  @@index([cashboxId, createdAt])
}

enum ExpenseReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ExpensePaymentStatus {
  UNPAID
  PAID
}

enum ExpensePaymentMethod {
  CASH
  BOLD
  TRANSFER
  OTHER
}

model ExpenseCategory {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringExpense {
  id Int @id @default(autoincrement())

  categoryId Int
  name       String
  amount     Int
  dayOfMonth Int

  active Boolean @default(true)

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // First eligible month, stored at UTC midnight.
  startMonth DateTime

  @@index([startMonth])
}

model Expense {
  id Int @id @default(autoincrement())

  categoryId         Int
  recurringExpenseId Int?

  // First day of the recurring month, stored at UTC midnight.
  // Null for manually entered expenses.
  recurringMonth DateTime?

  description String
  supplier    String?
  amount      Int

  expenseDate DateTime
  paidAt      DateTime?

  reviewStatus  ExpenseReviewStatus   @default(PENDING_REVIEW)
  paymentStatus ExpensePaymentStatus  @default(UNPAID)
  paymentMethod ExpensePaymentMethod?

  createdById  Int
  reviewedById Int?
  reviewedAt   DateTime?

  // Prevent duplicate purchases when a request is retried.
  // Nullable to preserve existing and recurring expense records.
  idempotencyKey String? @unique

  // Reserved for a future Cashbox integration.
  // No cash movements are created by this model.
  cashMovementId Int? @unique

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: Restrict)

  createdBy User @relation("ExpensesCreated", fields: [createdById], references: [id], onDelete: Restrict)

  reviewedBy User? @relation("ExpensesReviewed", fields: [reviewedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts ExpenseReceipt[]

  // Prevent generating the same monthly expense twice.
  @@unique([recurringExpenseId, recurringMonth])
  @@index([expenseDate, reviewStatus])
  @@index([categoryId, expenseDate])
}

model ExpenseReceipt {
  id Int @id @default(autoincrement())

  expenseId    Int
  uploadedById Int

  originalName String
  mimeType     String
  sizeBytes    Int

  // Prevent duplicate receipt records when an upload is retried.
  idempotencyKey String? @unique

  // SHA-256 of the original uploaded file contents.
  // Nullable for receipts created before checksum support.
  contentSha256 String?

  // Private Vercel Blob pathname.

  blobPathname String @unique

  createdAt DateTime @default(now())

  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  uploadedBy User    @relation("ExpenseReceiptsUploaded", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([expenseId, createdAt])
  @@index([uploadedById])
}
